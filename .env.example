# ============================================================================
# Free Daily AI Story Video Automation System - Configuration Template
# Copy this file to `.env` and fill in your credentials.
# Never commit your actual `.env` file to version control!
# ============================================================================

# --- 1. AI Story Generation (OpenRouter Free Tier Only) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Must end with `:free` or `/free` to enforce the zero-budget safeguard
OPENROUTER_MODEL=openrouter/free
# Optional secondary free model routes if primary free endpoint is at capacity
OPENROUTER_FALLBACK_MODEL=google/gemma-2-9b-it:free,meta-llama/llama-3.1-8b-instruct:free,mistralai/mistral-7b-instruct:free,nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=3

# --- 2. Story Parameters (Targeting 60+ Second Dramatic Videos) ---
STORY_LANGUAGE=English
STORY_MIN_WORDS=150
STORY_MAX_WORDS=190
STORY_MIN_SCENES=5
STORY_MAX_SCENES=8
STORY_SIMILARITY_THRESHOLD=0.65

# --- 3. Image Providers & Local Library ---
PIXABAY_API_KEY=
OPENVERSE_ENABLED=false
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20
IMAGE_MAX_BYTES=15728640

# --- 4. Local Piper Text-to-Speech ---
PIPER_EXECUTABLE=piper
# Recommended Public Domain voice: en_US-ljspeech-medium
# Recommended CC BY 4.0 voice: en_US-libritts_r-medium
PIPER_VOICE=en_US-ljspeech-medium
PIPER_MODEL_PATH=models/piper/en_US-ljspeech-medium.onnx
PIPER_CONFIG_PATH=models/piper/en_US-ljspeech-medium.onnx.json
PIPER_SPEAKER_ID=
PIPER_LENGTH_SCALE=1.0
PIPER_VOLUME=1.0
PIPER_SENTENCE_SILENCE=0.25
# Set to true ONLY for local dry-run testing without a downloaded Piper .onnx model
ALLOW_OFFLINE_TTS_FALLBACK=false

# --- 5. Directories ---
MUSIC_DIRECTORY=assets/music
IMAGE_DIRECTORY=assets/backgrounds
FONT_DIRECTORY=assets/fonts
LICENSE_DIRECTORY=assets/licenses
OUTPUT_DIRECTORY=output
HISTORY_FILE=data/history.json

# --- 6. Audio & Video Rendering ---
ALLOW_NARRATION_ONLY_FALLBACK=true
MUSIC_VOLUME=0.28
INTERNET_ARCHIVE_MUSIC_ENABLED=true
FREESOUND_API_KEY=
MUSIC_FADE_IN_SECONDS=1.5
MUSIC_FADE_OUT_SECONDS=2.5
ENABLE_AUDIO_DUCKING=true
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
CROSSFADE_DURATION_SECONDS=0.5
TITLE_OVERLAY_SECONDS=3.5
DARK_OVERLAY_OPACITY=0.28
SUBTITLE_FONT_NAME=Arial
SUBTITLE_FONT_SIZE=16
SUBTITLE_MARGIN_V=65
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_PRESET=medium
FFMPEG_CRF=21
KEEP_TEMP_FILES=false

# --- 7. Execution & Platform Publishing Flags ---
# DRY_RUN defaults to true so no live uploads occur until explicitly set to false
DRY_RUN=true
ENABLE_YOUTUBE=false
ENABLE_INSTAGRAM=false
ENABLE_FACEBOOK=false
ENABLE_TIKTOK=false
LOG_LEVEL=INFO

# --- 8. YouTube Shorts Official Data API v3 (OAuth 2.0) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Options: private, unlisted, public (unverified Google Cloud apps are restricted to private)
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=24

# --- 9. Instagram Reels Official Graph API (Professional Business/Creator Account) ---
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Public HTTPS base URL where Meta's servers can fetch the rendered MP4 during container creation
INSTAGRAM_VIDEO_PUBLIC_URL_BASE=
INSTAGRAM_GRAPH_VERSION=v22.0

# --- 10. Facebook Page Reels Official Graph API ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v22.0

# --- 11. TikTok Official Content Posting API v2 ---
TIKTOK_ACCESS_TOKEN=
# Options: SELF_ONLY, MUTUAL_FOLLOW_FRIENDS, PUBLIC_TO_EVERYONE (unaudited apps must use SELF_ONLY)
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
